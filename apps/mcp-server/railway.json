{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/mcp-server/Dockerfile",
    "watchPatterns": ["apps/mcp-server/**", "packages/**"]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  },
  "environments": {
    "$default": {
      "variables": {
        "APP_BASE_URL": "https://${{mcp.RAILWAY_PUBLIC_DOMAIN}}",
        "BETTER_AUTH_URL": "https://${{web.RAILWAY_PUBLIC_DOMAIN}}",
        "WEB_APP_URL": "https://${{web.RAILWAY_PUBLIC_DOMAIN}}"
      }
    }
  }
}
